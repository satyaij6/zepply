{
  "name": "zepply-platform",
  "private": true,
  "description": "Zepply — Create. Reply. Multiply. Web app, mobile app, shared packages and workers.",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@zepply/web",
    "dev:mobile": "pnpm --filter @zepply/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.34.6"
}
