generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  name            String?
  plan            Plan     @default(FREE)
  /// Allowlist for the video engine until credits exist; set to true by hand for pilot users.
  canCreateVideos Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Onboarding (/start). Answers shape the brand kit and the content Zepply writes.
  /// creator | business
  path           String?
  /// Languages to create in, e.g. ["en", "te"] (values from lib/reels/options LANGUAGES)
  languages      String[]  @default([])
  /// Creator: what they create (personal-brand, education…). Business: business type (cafe, clinic…).
  niche          String?
  /// What they want from Zepply, e.g. ["grow-followers", "more-leads"]
  goals          String[]  @default([])
  /// Last onboarding step reached (1-6), so a refresh or the Instagram round trip resumes there
  onboardingStep Int       @default(0)
  /// Set when onboarding is finished or skipped; until then sign-in lands on /start
  onboardedAt    DateTime?

  igAccounts InstagramAccount[]
  clipJobs   ClipJob[]
  drafts     Draft[]
  brandKit   BrandKit?
  reelJobs   ReelJob[]
}

model InstagramAccount {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId       String      @unique
  igUsername     String
  igProfilePic   String?
  followerCount  Int         @default(0)
  accessToken    String
  tokenExpiresAt DateTime
  isActive       Boolean     @default(true)
  triggers       Trigger[]
  leads          Lead[]
  analytics      Analytics[]
  createdAt      DateTime    @default(now())
}

model Trigger {
  id                String           @id @default(cuid())
  igAccountId       String
  igAccount         InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  name              String?
  type              TriggerType
  keywords          String[]
  replyMessage      String
  deliverLink       String?
  followGate        Boolean          @default(false)
  publicReplyOn     Boolean          @default(false)
  publicReplies     String[]
  postScope         String?
  openingDmText     String?
  openingDmBtnLabel String?
  followUpOn        Boolean          @default(false)
  followUpText      String?
  followUpDelayMins Int?
  isActive          Boolean          @default(true)
  hitCount          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  leads             Lead[]
}

model Lead {
  id          String           @id @default(cuid())
  igAccountId String
  igAccount   InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  triggerId   String?
  trigger     Trigger?         @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  igUserId    String
  igUsername  String
  capturedAt  DateTime         @default(now())
}

model Analytics {
  id            String           @id @default(cuid())
  igAccountId   String
  igAccount     InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  date          DateTime         @default(now())
  triggersHit   Int              @default(0)
  leadsCaptured Int              @default(0)
  dmsSent       Int              @default(0)
}

enum Plan {
  FREE
  PRO
}

enum TriggerType {
  COMMENT
  DM_KEYWORD
  STORY_REPLY
  NEW_FOLLOWER
}

/// One long video submitted to the clip engine. The Python worker in workers/clipper
/// claims QUEUED jobs (SELECT … FOR UPDATE SKIP LOCKED) and reports progress here.
model ClipJob {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  sourceKind    ClipSourceKind
  /// Object path in the "clip-sources" bucket (uploads)
  sourcePath    String?
  /// Link to the video (YouTube)
  sourceUrl     String?
  /// The user confirmed they own the linked content
  ownsContent   Boolean        @default(false)
  language      String         @default("te")
  clipCount     Int            @default(5)
  style         String         @default("clean")
  captionPos    String         @default("bottom")
  /// Framing: auto (speaker tracking; screen recordings detected), screen (screen + webcam), single
  layout        String         @default("auto")
  /// Zoom punch-ins on emphasised words
  effects       Boolean        @default(true)
  /// Post copy for the long video itself: { titles, description, chapters: [{ start, title }] }
  sourceKit     Json?
  status        ClipJobStatus  @default(QUEUED)
  /// Engine stage in progress: preparing, transcribing, finding_moments, rendering, uploading
  stage         String?
  /// 0–100
  progress      Int            @default(0)
  error         String?
  attempts      Int            @default(0)
  workerId      String?
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  sourceSeconds Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  clips         Clip[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One finished short cut from a ClipJob, best first.
model Clip {
  id              String   @id @default(cuid())
  jobId           String
  job             ClipJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rank            Int
  title           String
  theme           String?
  reason          String?
  format          String?
  hookScore       Float?
  standaloneScore Float?
  coherenceScore  Float?
  finalScore      Float?
  durationSec     Float?
  /// Object paths in the "clip-renders" bucket
  videoPath       String
  captionsPath    String?
  thumbPath       String?
  /// Cover image (best still + hook text), in "clip-renders"
  coverPath       String?
  /// Post copy: title options, caption and hashtags (without '#')
  titles          String[] @default([])
  caption         String?
  hashtags        String[] @default([])
  rejected        Boolean  @default(false)
  rejectReason    String?
  createdAt       DateTime @default(now())

  @@index([jobId, rank])
}

enum ClipJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum ClipSourceKind {
  UPLOAD
  YOUTUBE
}

/// What a business tells us once, so every promo reel after the first is quick.
model BrandKit {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName  String
  handle     String?
  /// One line about the business, in the owner's words
  about      String?
  location   String?
  /// Brand colour, #RRGGBB
  accent     String   @default("#3D7EFF")
  /// Object path in the "brand-assets" bucket
  logoPath   String?
  /// Object paths in the "brand-assets" bucket, in display order (up to 6)
  photoPaths String[] @default([])
  language   String   @default("en")
  /// Up to four brand colours, #RRGGBB, most important first (accent mirrors the first)
  colors     String[] @default([])
  /// Headline typeface for designs (values from lib/onboarding/options FONTS)
  font       String?
  /// How the brand sounds, e.g. ["Warm", "Conversational"]
  voice      String[] @default([])
  /// Who the brand is for, in one or two sentences
  audience   String?
  /// What the brand sells or offers, e.g. ["Coffee", "Coworking"]
  offerings  String[] @default([])
  /// What the brand posts about, e.g. ["Behind the scenes", "Offers & events"]
  themes     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

/// A post Zepply wrote for the user, not yet published (onboarding samples, later the content calendar).
model Draft {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       DraftKind
  /// Short on-image text
  headline   String
  caption    String
  hashtags   String[]  @default([])
  /// Object paths in the "brand-assets" bucket, in slide order
  photoPaths String[]  @default([])
  /// Carousel: a short label per slide after the cover
  slides     String[]  @default([])
  language   String    @default("en")
  /// Where it came from: onboarding | create
  source     String    @default("onboarding")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
}

enum DraftKind {
  POST
  CAROUSEL
  REEL
}

/// One promo reel render. A single "Generate" makes one job per chosen format, sharing a groupId.
model ReelJob {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String
  template    String        @default("promo-classic")
  /// vertical | portrait | wide
  format      String
  /// standard (30s) | short (15s)
  length      String        @default("standard")
  /// upbeat | calm | premium
  music       String        @default("upbeat")
  /// Template variables; logo/photos hold "brand-assets" object paths, not URLs
  variables   Json
  status      ClipJobStatus @default(QUEUED)
  /// 0–100
  progress    Int           @default(0)
  error       String?
  attempts    Int           @default(0)
  workerId    String?
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Object path in the "reel-renders" bucket
  outputPath  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([groupId])
}
