# Copy to .env.local and fill in. Production values live in Vercel
# (Project → Settings → Environment Variables); `vercel env pull` copies them.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (NextAuth v5)
AUTH_SECRET=

# Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client, type "Web application")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database (Supabase Postgres via Prisma)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Instagram
META_FB_APP_ID=
META_FB_APP_SECRET=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Promo reels: Claude writes the reel's words. Without a key, a plain built-in script is used.
ANTHROPIC_API_KEY=
# REELS_SCRIPT_MODEL=claude-sonnet-5-5

# Email (Resend)
RESEND_API_KEY=
