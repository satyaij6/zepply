# Clipper
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Worker (python -m worker). Use the same Supabase project as apps/web.
# Direct Postgres connection (Supabase: Settings -> Database -> Connection string, "Direct").
ZEPPLY_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional
# Which queues to work: clips, reels or clips,reels (default). Reels need neither key above.
# ZEPPLY_JOBS=clips,reels
# ZEPPLY_NODE=node
# ZEPPLY_RENDER_WORKERS=2
# ZEPPLY_WORK_DIR=        # default ~/zepply-worker
# ZEPPLY_POLL_SECONDS=5
# ZEPPLY_DEVICE=auto      # auto | cuda | cpu
